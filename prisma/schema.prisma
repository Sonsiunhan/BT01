generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SYSTEM_ADMIN
  TOURNAMENT_ADMIN
  REFEREE
  BROADCAST_OBSERVER
}

model User {
  role              Role          @default(USER)
  id                String        @id @default(uuid())
  fullName          String
  displayName       String
  username          String        @unique
  usernameNormalized String       @unique
  passwordHash      String
  recoveryCodeHash  String
  recoveryUsedAt    DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  profile           UserProfile?
  stats             UserStats?
  sessions          Session[]
  sentFriendRequests FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestRecipient")
  friendshipsA      Friendship[] @relation("FriendshipA")
  friendshipsB      Friendship[] @relation("FriendshipB")
  blocksGiven       Block[] @relation("Blocker")
  blocksReceived    Block[] @relation("Blocked")
  guestHistoryImports GuestHistoryImport[]
  botLibraries      BotLibrary[]
  rulesAcknowledgements TournamentRulesAcknowledgement[]

  @@index([usernameNormalized])
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  theme     String   @default("system")
  avatarPreset String @default("robot")
  presenceVisibility String @default("FRIENDS")
  friendListVisibility String @default("PRIVATE")
  fullNameVisibility String @default("PRIVATE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserStats {
  id          String   @id @default(uuid())
  userId      String   @unique
  elo         Int      @default(1000)
  rankedWins  Int      @default(0)
  rankedLosses Int     @default(0)
  quickWins   Int      @default(0)
  quickLosses Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  remember   Boolean  @default(false)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RankedMatchResult {
  matchId       String   @id
  blueUserId    String
  redUserId     String
  resultReason  String
  blueBefore    Int
  blueAfter     Int
  blueDelta     Int
  redBefore     Int
  redAfter      Int
  redDelta      Int
  createdAt     DateTime @default(now())
}

model Match {
  id              String        @id
  roomId          String
  mode            String
  playMode        String        @default("MANUAL")
  status          String
  resultReason    String?
  winnerSide      String?
  timerSeconds    Int
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  finalBoard     Json?
  botAdjudication Json?
  rulesVersion    String?        @default("rps-v1")
  setupVersion    String?
  initialSeed     Int?
  initialSignature String?
  initialBoard    Json?
  cursorSequence  Int?           @default(0)
  tournamentId    String?
  pinnedConfigVersionId String?
  finishSequence  Int?
  createdAt       DateTime       @default(now())
  players         MatchPlayer[]
  moves           MatchMove[]
  checkpoint      MatchCheckpoint?
  events          MatchEvent[]

  @@index([endedAt])
  @@index([playMode, endedAt])
  @@index([roomId])
  @@index([tournamentId, finishSequence])
}

model MatchMove {
  id              String   @id @default(uuid())
  matchId         String
  sequence        Int
  stateVersion    Int
  side            String
  fromCoordinate  String
  toCoordinate    String
  capturedPieceId String?
  committedAt     DateTime @default(now())
  match           Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, sequence])
  @@index([matchId, stateVersion])
}

model MatchCheckpoint {
  matchId        String   @id
  roomId         String
  sequence       Int
  stateVersion   Int
  rulesVersion   String?  @default("rps-v1")
  setupVersion   String?
  initialSeed    Int?
  initialSignature String?
  initialBoard   Json?
  cursorSequence Int?     @default(0)
  lifecycleJson  Json?
  snapshot       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([roomId, updatedAt])
}

model MatchEvent {
  id           String   @id @default(uuid())
  matchId      String
  sequence     Int
  stateVersion Int
  type         String
  payload      Json
  createdAt    DateTime @default(now())
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, sequence])
  @@index([matchId, createdAt])
}

model MatchPlayer {
  id           String   @id @default(uuid())
  matchId      String
  userId       String
  username     String
  displayName  String
  side         String
  isWinner     Boolean?
  ratingBefore Int?
  ratingAfter  Int?
  ratingDelta  Int?
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId, matchId])
}

model FriendRequest {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  pairKey     String   @unique
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sender      User     @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("FriendRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, recipientId])
  @@index([recipientId, status])
  @@index([senderId, status])
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  userA     User     @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model GuestHistoryImport {
  id         String   @id @default(uuid())
  userId     String
  localId    String
  payload    Json
  importedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localId])
  @@index([userId, importedAt])
}

model GuestSession {
  id           String       @id
  tokenHash    String       @unique
  displayName  String
  createdAt    DateTime     @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  botLibraries BotLibrary[]

  @@index([expiresAt])
}

model BotLibrary {
  id          String        @id @default(uuid())
  ownerUserId String?
  ownerGuestId String?
  name        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       User?         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  guestOwner  GuestSession? @relation(fields: [ownerGuestId], references: [id], onDelete: Cascade)
  revisions   BotRevision[]

  @@unique([ownerUserId, name])
  @@unique([ownerGuestId, name])
  @@index([ownerUserId, updatedAt])
  @@index([ownerGuestId, updatedAt])
}

model BotRevision {
  id                 String      @id @default(uuid())
  botLibraryId       String
  revisionNumber     Int
  sdkVersion         String
  schemaVersion      String
  sourceDigest       String
  sourceBytes        Int
  sourceText         String
  status             String
  validationCode     String?
  validationMessage  String?
  preflightMs        Int?
  memoryPolicy       String      @default("RESET_ON_NEW_REVISION")
  activeForMatchId  String?
  pendingForMatchId String?
  sourceExpiresAt    DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  botLibrary         BotLibrary  @relation(fields: [botLibraryId], references: [id], onDelete: Cascade)

  @@unique([botLibraryId, revisionNumber])
  @@unique([botLibraryId, sourceDigest])
  @@index([botLibraryId, updatedAt])
}

model CommandLedgerEntry {
  id             String    @id @default(uuid())
  principalId    String
  targetId       String
  operation      String
  commandId      String
  payloadDigest  String?
  outcome        String
  stateVersion   Int
  sequence       Int
  ackPayload     Json?
  receivedAt     DateTime  @default(now())
  committedAt    DateTime?
  expiresAt      DateTime?

  @@unique([principalId, targetId, operation, commandId])
  @@index([targetId, expiresAt])
  @@index([commandId])
}

model RoomContext {
  id             String           @id
  generation     Int              @default(1)
  stateVersion   Int              @default(0)
  activeMatchId  String?
  previousSetup  Json?
  config         Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  memberships    RoomMembership[]

  @@index([updatedAt])
}

model RoomMembership {
  id             String       @id @default(uuid())
  roomId         String
  userId         String
  role           String       @default("PLAYER")
  side           String?
  principal      String       @default("ACCOUNT")
  connected      Boolean      @default(true)
  joinedAt       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  room           RoomContext  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, role])
}

model BotPrivateCheckpoint {
  id               String    @id @default(uuid())
  matchId          String
  botId            String
  revisionId       String
  turnNumber       Int
  seed             Int?
  invocationEpoch  Int?
  invocationToken  String?
  memoryPayload    Json?
  budgetRemaining  Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([matchId, botId])
  @@index([matchId, turnNumber])
}

model MatchSettlement {
  id              String    @id @default(uuid())
  matchId         String    @unique
  settledAt       DateTime  @default(now())
  outcome         String
  eloApplied      Boolean   @default(false)
  historyRecorded Boolean   @default(false)
  payload         Json?

  @@index([settledAt])
}

model Unit {
  id           String               @id @default(uuid())
  unitCode     String               @unique
  unitName     String
  unitType     String
  contactName  String
  contactEmail String
  status       String               @default("ACTIVE")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  contracts    TournamentContract[]
  tournaments  Tournament[]

  @@index([status])
}

model TournamentContract {
  id                           String                        @id @default(uuid())
  contractCode                 String                        @unique
  unitId                       String
  status                       String                        @default("ACTIVE")
  validFrom                    DateTime
  validTo                      DateTime
  maxTournamentsTotal          Int
  quotaReservedCount           Int                           @default(0)
  quotaConsumedCount           Int                           @default(0)
  maxParticipantsPerTournament Int
  maxParticipantsTotal         Int
  allowedModes                 Json
  policyEnvelope               Json
  technicalCaps                Json
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  unit                         Unit                          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  taBindings                   TournamentContractTaBinding[]
  tournaments                  Tournament[]
  enrollments                  TournamentEnrollmentRecord[]

  @@index([unitId, status])
  @@index([validTo])
}

model TournamentContractTaBinding {
  id              String             @id @default(uuid())
  contractId      String
  userId          String
  username        String?
  displayName     String?
  status          String             @default("ACTIVE")
  grantedByUserId String
  grantedAt       DateTime           @default(now())
  revokedAt       DateTime?
  revokeReason    String?
  contract        TournamentContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, userId])
  @@index([userId, status])
}

model Tournament {
  id                        String                            @id @default(uuid())
  tournamentCode            String                            @unique
  contractId                String
  unitId                    String
  ownerTaUserId             String
  status                    String                            @default("DRAFT")
  revision                  Int                               @default(1)
  coreConfig                Json
  ruleProfile               Json
  activeConfigVersionId     String?
  activeConfigVersionNumber Int                               @default(0)
  approvedSnapshot          Json?
  everApproved              Boolean                           @default(false)
  quotaRefunded             Boolean                           @default(false)
  submittedAt               DateTime?
  approvedAt                DateTime?
  rejectedAt                DateTime?
  changesRequestedAt        DateTime?
  lastReviewNote            String?
  startedAt                 DateTime?
  pausedAt                  DateTime?
  pauseReason               String?
  endedAt                   DateTime?
  cancelledAt               DateTime?
  cancelReason              String?
  finalizedAt               DateTime?
  copiedFromTournamentId    String?
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  contract                  TournamentContract                @relation(fields: [contractId], references: [id], onDelete: Restrict)
  unit                      Unit                              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  configVersions            TournamentConfigVersionRecord[]
  changeRequests            TournamentChangeRequestRecord[]
  enrollments               TournamentEnrollmentRecord[]
  staffAssignments          TournamentStaffAssignmentRecord[]
  staffInvitations          TournamentStaffInvitation[]
  adjudications             ManualAdjudicationRequestRecord[]
  scoreLedgerEntries        TournamentScoreLedgerRecord[]

  @@index([contractId, status])
  @@index([status])
  @@index([ownerTaUserId])
}

model TournamentConfigVersionRecord {
  id                  String     @id @default(uuid())
  tournamentId        String
  versionNumber       Int
  coreConfigSnapshot  Json
  ruleProfileSnapshot Json
  effectiveAt         DateTime
  publishedByUserId   String
  changeSummary       String
  createdAt           DateTime   @default(now())
  tournament          Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  rulesAcknowledgements TournamentRulesAcknowledgement[]

  @@unique([id, tournamentId])
  @@unique([tournamentId, versionNumber])
  @@index([tournamentId, effectiveAt])
}

model TournamentChangeRequestRecord {
  id                       String     @id @default(uuid())
  tournamentId             String
  contractId               String
  requestedByTaUserId      String
  status                   String     @default("PENDING")
  reason                   String
  proposedCoreConfigPatch  Json?
  proposedRuleProfilePatch Json?
  effectiveAt              DateTime
  diffs                    Json
  reviewedByAdminUserId    String?
  reviewNote               String?
  reviewedAt               DateTime?
  appliedConfigVersionId   String?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  tournament               Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, status])
  @@index([status])
}

model TournamentEnrollmentRecord {
  id                  String             @id @default(uuid())
  tournamentId        String
  contractId          String
  personKey           String
  userId              String?
  displayName         String
  unitCode            String
  email               String?
  seedRating          Int                @default(1000)
  eligibilityStatus   String             @default("ELIGIBLE")
  checkedInAt         DateTime?
  pinnedBotRevisionId String?
  botReadinessStatus  String             @default("NOT_REQUIRED")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tournament          Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  contract            TournamentContract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@unique([tournamentId, personKey])
  @@index([contractId])
  @@index([tournamentId, eligibilityStatus])
  @@index([userId, tournamentId])
}

model TournamentStaffAssignmentRecord {
  id            String     @id @default(uuid())
  tournamentId  String
  userId        String
  role          String
  status        String     @default("ACTIVE")
  assignedRooms Json?
  invitationId  String?    @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  invitation    TournamentStaffInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, userId, role])
  @@index([userId, status])
}

/// Durable, one-time staff/referee invitation handoff for D06-A.
/// Raw tokens are never persisted; tokenHash is SHA-256 of the handoff token.
model TournamentStaffInvitation {
  id               String   @id @default(uuid())
  tournamentId     String
  contractId       String
  recipientUserId  String
  role             String
  purpose          String   @default("TOURNAMENT_STAFF_INVITE")
  status           String   @default("INVITED")
  tokenHash        String   @unique
  idempotencyKey   String
  inviterUserId    String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  acceptedAt       DateTime?
  declinedAt       DateTime?
  revokedAt        DateTime?
  tournament       Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  assignment       TournamentStaffAssignmentRecord?

  @@unique([tournamentId, idempotencyKey])
  @@index([tournamentId, status])
  @@index([recipientUserId, status])
  @@index([expiresAt, status])
}

/// Durable support/recovery queue record for D07-A.
/// Only the one-way recovery token hash is persisted; raw tokens are handoff-only.
model SupportRecoveryTicket {
  id                      String    @id @default(uuid())
  tenantId                String?
  requestType             String    @default("ACCOUNT_RECOVERY")
  targetUserId            String
  requesterUserId         String?
  description             String
  status                  String    @default("OPEN")
  assignedOperatorUserId  String?
  verificationReference   String?
  idempotencyKey          String
  recoveryTokenHash       String?   @unique
  recoveryTokenPurpose    String?
  recoveryTokenExpiresAt  DateTime?
  recoveryTokenIssuedAt   DateTime?
  recoveryTokenConsumedAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  verifiedAt              DateTime?
  rejectedAt              DateTime?
  resolvedAt              DateTime?
  closedAt                DateTime?

  @@unique([targetUserId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([targetUserId, status])
  @@index([assignedOperatorUserId, status])
  @@index([recoveryTokenExpiresAt])
}

model ManualAdjudicationRequestRecord {
  id                String     @id @default(uuid())
  tournamentId      String
  matchId           String     @unique
  roomId            String
  blueParticipantId String
  redParticipantId  String
  status            String     @default("WAITING")
  frozenSnapshot    Json
  deadlineAt        DateTime
  fallbackPolicy    String
  winnerSide        String?
  decidedByUserId   String?
  decisionReason    String?
  decidedAt         DateTime?
  finishSequence    Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  tournament        Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, status])
  @@index([deadlineAt, status])
}

model TournamentScoreLedgerRecord {
  id                String     @id @default(uuid())
  tournamentId      String
  matchId           String     @unique
  finishSequence    Int
  blueParticipantId String
  redParticipantId  String
  winnerSide        String
  resolutionSource  String
  blueEloBefore     Int
  blueEloAfter      Int
  blueScoreBefore   Int
  blueScoreAfter    Int
  redEloBefore      Int
  redEloAfter       Int
  redScoreBefore    Int
  redScoreAfter     Int
  finishedAt        DateTime   @default(now())
  tournament        Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, finishSequence])
  @@index([tournamentId, finishSequence])
}

model TournamentAuditLogRecord {
  id             String   @id @default(uuid())
  actorUserId    String
  actorRole      String
  action         String
  targetType     String
  targetId       String
  beforeSnapshot Json?
  afterSnapshot  Json?
  reason         String?
  correlationId  String?
  createdAt      DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
}



/// D08-A: immutable explicit acknowledgement; no credentials, tokens or copied PII.
/// Migration and identity-mapping/deletion policy require Long review.
model TournamentRulesAcknowledgement {
  id              String   @id @default(uuid())
  userId          String
  contractId      String
  tournamentId    String
  configVersionId String
  acknowledgedAt  DateTime @default(now())
  evidenceKind    String   @default("AUTHENTICATED_EXPLICIT_ACK")
  user            User @relation(fields: [userId], references: [id], onDelete: Restrict)
  configVersion   TournamentConfigVersionRecord @relation(fields: [configVersionId, tournamentId], references: [id, tournamentId], onDelete: Restrict)

  @@unique([userId, contractId, tournamentId, configVersionId])
  @@index([contractId, tournamentId])
}

/// D08-A: server-provisioned, versioned policy metadata; no public writer.
model ArtifactRetentionPolicyRecord {
  artifact  String @id
  policy    Json
  updatedAt DateTime @updatedAt
}
