{
  "name": "@ottv2/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node --test ../../scripts/r3-artifact-pins.test.mjs && node ../../scripts/r3-render-provider-probe.mjs",
    "probe:r3:provider": "node ../../scripts/r3-render-provider-probe.mjs --require-pass",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "db:validate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js validate --schema ../../prisma/schema.prisma",
    "db:migrate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate dev --schema ../../prisma/schema.prisma",
    "db:deploy": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate deploy --schema ../../prisma/schema.prisma",
    "db:status": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate status --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@ottv2/contracts": "workspace:*",
    "@ottv2/game-rules": "workspace:*",
    "@ottv2/bot-sdk": "workspace:*",
    "@prisma/client": "^6.7.0",
    "fastify": "^5.3.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prisma": "^6.7.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.0",
    "vitest": "^3.1.2"
  }
}
